# Neon Postgres. Vercel 연동 시 자동 주입되지만 로컬 마이그레이션·시드에는 직접 필요하다.
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# 시드 11편의 작성자 키(원본). 서버에는 SHA-256 해시만 들어간다.
# 비워두면 seed/load.js가 새로 만들어 한 번만 출력한다 — 그 줄을 여기 옮겨 적는다.
SEED_AUTHOR_KEY=

# 유튜브 Data API. 없으면 ② 영상 확정 화면이 "직접 링크 입력"만 띄우고 계속 동작한다.
# search.list는 하루 100 calls 경성 상한(2026-06-01 쿼터 개정).
YOUTUBE_API_KEY=

# Upstash Redis — 피드 캐시 3키 + 레이트리밋 카운터. Vercel Marketplace 연동 시 KV_ prefix로 주입된다.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# POST /api/admin/hide 용 비밀 토큰. 운영자 숨김은 이 엔드포인트로만 한다(캐시 퍼지 때문에).
ADMIN_TOKEN=
