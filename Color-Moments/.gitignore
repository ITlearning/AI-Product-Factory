build/
DerivedData/

# Xcode 가 사람마다 다르게 쓰는 UI 상태. xcodeproj 는 xcodegen 산출물이라 커밋하지만
# 이 안의 xcuserdata 는 사람마다 충돌한다. 두 자리 모두 막는다 —
# project.xcworkspace 밑에도 따로 생긴다.
xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

.DS_Store

# 비밀값 — 커밋 금지
.env
.env.*
.superpowers/
# fastlane 이 읽는 값의 빈 틀 — 이것만 커밋한다.
!fastlane/.env.default

# fastlane 산출물
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output
*.ipa
*.dSYM.zip

# Bundler
vendor/bundle/
.bundle/
