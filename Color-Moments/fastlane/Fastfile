default_platform(:ios)

# fastlane이 매 실행마다 fastlane/README.md를 자동 갱신하는 걸 막는다.
# 우리 가이드는 fastlane/SETUP.md 가 정본.
skip_docs

# 프로젝트 위치는 fastlane 디렉터리의 부모. pbxproj 는 project.yml 에서 xcodegen 으로 만든다.
XCODEPROJ = "ColorMoments.xcodeproj"
SCHEME    = "ColorMoments"
APP_ID    = "com.itlearning.colormoments"
ROOT      = File.expand_path("..", __dir__)

platform :ios do

  # ASC env 검증. .env.default의 placeholder가 실수로 그대로 통과하지 않도록 명시적으로 거른다.
  def assert_asc_env!
    placeholders = ["XXXXXXXXXX", "00000000-0000-0000-0000-000000000000", "/absolute/path/to/AuthKey_XXXXXXXXXX.p8"]
    %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].each do |k|
      v = ENV[k].to_s
      if v.empty?
        UI.user_error!("환경변수 #{k} 가 설정되지 않았습니다. fastlane/.env.default 참고해서 fastlane/.env 를 만들어주세요.")
      end
      if placeholders.include?(v)
        UI.user_error!("환경변수 #{k} 가 placeholder 값(#{v})입니다. fastlane/.env 에 실제 값을 채워주세요.")
      end
    end
    unless File.exist?(ENV["ASC_KEY_PATH"])
      UI.user_error!("ASC_KEY_PATH(#{ENV["ASC_KEY_PATH"]}) 파일이 존재하지 않습니다. App Store Connect에서 받은 .p8 파일 경로를 확인해주세요.")
    end
  end

  def asc_api_key
    assert_asc_env!
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      duration: 1200,
      in_house: false,
    )
  end

  def latest_build(api_key)
    latest_testflight_build_number(app_identifier: APP_ID, api_key: api_key, initial_build_number: 0)
  end

  # 키체인에 Apple Distribution 인증서가 없다 — Xcode 클라우드 관리 인증서로 서명한다.
  # API 키를 xcodebuild 에 넘기면 「Cloud signing permission error」— 키 권한이 클라우드 인증서에 못 닿는다.
  # 그래서 Xcode 에 로그인된 계정으로 프로비저닝을 받는다(Organizer 로 올릴 때와 같은 길).
  def signing_xcargs
    "-allowProvisioningUpdates"
  end

  # 빌드 번호는 pbxproj 에 쓰지 않고 빌드 때만 넘긴다 — xcodegen 이 다시 만들어도 안 꼬이고, 앱과 두 확장이 같은 번호를 받는다.
  # gym 은 xcargs 를 내보내기(-exportArchive)에도 붙인다 — export_xcargs 로 또 주면 「may only be provided once」로 죽는다.
  def archive(build_number, archive_path: nil)
    build_app(
      archive_path: archive_path,
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      output_name: "ColorMoments.ipa",
      include_symbols: true,
      include_bitcode: false,
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} #{signing_xcargs}",
    )
  end

  desc "TestFlight의 마지막 빌드 번호만 확인 (아무것도 올리지 않음)"
  lane :latest do
    n = latest_build(asc_api_key)
    UI.success("마지막 TestFlight 빌드: #{n} → 다음 beta 는 #{n + 1}")
  end

  desc "TestFlight에 새 베타 빌드 업로드 (빌드 번호 = TestFlight 마지막 + 1)"
  lane :beta do
    api_key = asc_api_key
    archive(latest_build(api_key) + 1)

    # 모노레포라 저장소 전체 로그가 아니라 몽돌 디렉터리 커밋만 테스터 메모로.
    changelog = sh("git", "-C", ROOT, "log", "-10", "--no-merges", "--pretty=- %s", "--", ".", log: false).strip

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: changelog,
    )

    UI.success("✅ TestFlight 업로드 완료. App Store Connect에서 처리 상태 확인 후 테스터에 배포하세요.")
  end

  desc "로컬에서 release 아카이브·ipa 검증만 (업로드 X, 빌드 번호는 TestFlight 마지막 + 1)"
  lane :build_only do
    # Organizer 에 안 올린 아카이브가 쌓이면 손으로 잘못 올리기 쉽다 — build/ 에만 둔다.
    archive(latest_build(asc_api_key) + 1, archive_path: "build/ColorMoments.xcarchive")
  end

  desc "시뮬레이터에서 단위 테스트"
  lane :test do |options|
    run_tests(
      project: XCODEPROJ,
      scheme: SCHEME,
      device: options[:device] || "iPhone 16 Pro",
      xcargs: "-collect-test-diagnostics never",
      output_directory: "fastlane/test_output",
      output_types: "junit",
      result_bundle: true,
      fail_build: true,
    )
    UI.success("✅ 모든 테스트 통과. 리포트: fastlane/test_output/")
  end

  error do |lane, exception|
    UI.error("Lane #{lane} 실패: #{exception.message}")
  end
end
